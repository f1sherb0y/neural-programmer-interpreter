# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.coverage
.coverage.*
htmlcov/

# Virtual environments and local configuration
.venv/
venv/
env/
.env
.env.*
!.env.example
.python-version.local

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Editors and operating systems
.vscode/
.idea/
.DS_Store
*~

# Training logs, scheduler output, and temporary files
*.log
*.out
slurm-*.out
wandb/
runs/
checkpoints/
*.tmp

# Model snapshots are generated unless explicitly curated below.
*.pt
*.pth
*.ckpt
*.ckpt.*

# Experiment artifacts are local by default. Keep only compact reports and the
# two primary reproducibility checkpoints in version control.
artifacts/**
!artifacts/addition.pt
!artifacts/addition_results.json
!artifacts/addition_10_digit_results.json
!artifacts/addition_10000_digit_results.json
!artifacts/generalization_sweep_fixed/
artifacts/generalization_sweep_fixed/**
!artifacts/generalization_sweep_fixed/generalization_sweep.json
!artifacts/generalization_sweep_fixed/train_vs_generalization.csv
!artifacts/generalization_sweep_fixed/train_vs_generalization.pdf
!artifacts/generalization_sweep_fixed/train_vs_generalization.png
!artifacts/training_curve_20/
artifacts/training_curve_20/**
!artifacts/training_curve_20/training_curve.csv
!artifacts/training_curve_20/training_curve.json
!artifacts/training_curve_20/training_curve.pdf
!artifacts/training_curve_20/training_curve.png
!artifacts/graph_dijkstra/
artifacts/graph_dijkstra/**
!artifacts/graph_dijkstra/best.pt
!artifacts/graph_dijkstra/evaluation.json
!artifacts/graph_dijkstra/results.pdf
!artifacts/graph_dijkstra/results.png
!artifacts/graph_dijkstra/training_history.json
